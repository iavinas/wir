# Provider
WIR_PROVIDER_BASE_URL=https://api.openai.com/v1
WIR_PROVIDER_API_KEY=
WIR_MODEL=gpt-4o-mini
WIR_PROVIDER_TIMEOUT_MS=120000

# Generation
WIR_DISABLE_THINKING=0
WIR_TEMPERATURE=0
WIR_SEED=20260807

# Agent behavior
WIR_READ_SCREENSHOT=0
WIR_SITE_SKILLS=0
WIR_REPEAT_NUDGE=1
WIR_BUDGET_CHECKPOINT=1

# Debugging
WIR_DEBUG_SCREENSHOTS=0
WIR_LOG_PROMPT=0

# Telemetry is explicitly disabled by default.
WIR_TELEMETRY=off
WIR_TELEMETRY_LOG_VALUES=0
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=
# LANGFUSE_HOST=
# WIR_TELEMETRY_ENV=

# Optional cost estimates, in currency units per million tokens.
# WIR_PRICE_INPUT_PER_MTOK=
# WIR_PRICE_OUTPUT_PER_MTOK=
# WIR_PRICE_CACHED_INPUT_PER_MTOK=
